# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# NextDNS accounts to collect from, as short names (letters, digits, underscores).
SVERDRUP_ACCOUNTS=home,family

# For each account NAME above, uppercased: its API key. Every profile the key
# can see is collected, and new profiles are picked up (and backfilled) on the
# next run.
NEXTDNS_HOME_API_KEY=replace-with-home-account-api-key
NEXTDNS_FAMILY_API_KEY=replace-with-family-account-api-key
# Optional: collect only these profile IDs for an account instead.
# NEXTDNS_FAMILY_PROFILES=fed321

# Optional profile groups, by profile ID or NextDNS profile name (names ignore
# case). The first group is the dashboard's default view. A group either lists
# its profiles (_PROFILES) or is every profile except some (_EXCLUDE), which
# also takes in profiles added later. "all" is reserved for every profile.
# SVERDRUP_GROUPS=HapLan,Kids
# SVERDRUP_GROUP_HAPLAN_EXCLUDE=Julie,Cumberland,calibration
# SVERDRUP_GROUP_KIDS_PROFILES=abc123,Tablet

# Optional settings (defaults shown)
NEXTDNS_API_URL=https://api.nextdns.io
COLLECTOR_INTERVAL=15
PROCESSOR_INTERVAL=60
SESSION_GAP_MINUTES=15
TZ=UTC
DASHBOARD_PORT=8080
